# Template only: copy to .env and put your real values THERE.
# This file is meant to be committed, so keep it free of real keys.

# --- Supabase (Project Settings -> API Keys, or `npx supabase status` locally) ---
# Browser: project URL + publishable key (the legacy "anon" key also works).
# Everything the browser does is limited by Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server: same URL + secret key (the legacy "service_role" key also works).
# Bypasses RLS. Never prefix it with VITE_ or ship it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --- Realtime server ---
# Port for the Express + Socket.io server (Vite proxies /api and /socket.io to it).
SERVER_PORT=4000
# Where the Vite dev server runs (allowed CORS origin).
CLIENT_ORIGIN=http://localhost:5173

# --- LiveKit (screen share only) ---
# cloud.livekit.io -> your project -> Settings -> API Keys. The URL is the
# project's wss:// address. Leave these empty to run without screen share.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
